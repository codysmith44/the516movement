{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1200px"
    },
    "color": {
      "palette": [
        {
          "slug": "primary",
          "name": "M516 Blue",
          "color": "#0f75bc"
        },
        {
          "slug": "navy",
          "name": "Navy",
          "color": "#0b3e63"
        },
        {
          "slug": "accent",
          "name": "Red",
          "color": "#c3272f"
        },
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#212121"
        },
        {
          "slug": "muted",
          "name": "Slate",
          "color": "#4a545a"
        },
        {
          "slug": "light",
          "name": "Light",
          "color": "#f5f5f5"
        },
        {
          "slug": "base",
          "name": "White",
          "color": "#ffffff"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "heading",
          "name": "Oswald",
          "fontFamily": "Oswald, system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Oswald",
              "fontWeight": "500 700",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/oswald-latin-wght-normal.woff2"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Inter",
          "fontFamily": "Inter, system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontWeight": "100 900",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/inter-latin-wght-normal.woff2"
              ]
            },
            {
              "fontFamily": "Inter",
              "fontWeight": "100 900",
              "fontStyle": "italic",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/inter-latin-wght-italic.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.9rem",
          "name": "Small"
        },
        {
          "slug": "medium",
          "size": "1.125rem",
          "name": "Medium"
        },
        {
          "slug": "large",
          "size": "1.6rem",
          "name": "Large",
          "fluid": {
            "min": "1.35rem",
            "max": "1.6rem"
          }
        },
        {
          "slug": "x-large",
          "size": "2.4rem",
          "name": "XL",
          "fluid": {
            "min": "1.8rem",
            "max": "2.4rem"
          }
        },
        {
          "slug": "huge",
          "size": "3.75rem",
          "name": "Huge",
          "fluid": {
            "min": "2.4rem",
            "max": "3.75rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.7"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "left": "1.25rem",
        "right": "1.25rem"
      }
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "600",
          "lineHeight": "1.15"
        },
        "color": {
          "text": "var(--wp--preset--color--navy)"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--navy)"
          }
        },
        ":focus": {
          "outline": {
            "width": "2px",
            "style": "solid",
            "color": "var(--wp--preset--color--accent)",
            "offset": "2px"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "#fff"
        },
        "border": {
          "radius": "6px"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "700",
          "textTransform": "uppercase",
          "letterSpacing": "0.04em"
        },
        "spacing": {
          "padding": {
            "top": ".8rem",
            "bottom": ".8rem",
            "left": "1.6rem",
            "right": "1.6rem"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--navy)"
          }
        },
        ":focus": {
          "outline": {
            "width": "3px",
            "style": "solid",
            "color": "var(--wp--preset--color--accent)",
            "offset": "2px"
          }
        }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "textTransform": "uppercase",
          "fontSize": "0.95rem",
          "letterSpacing": "0.03em"
        }
      },
      "core/quote": {
        "border": {
          "left": {
            "color": "var(--wp--preset--color--accent)",
            "width": "4px"
          }
        },
        "spacing": {
          "padding": {
            "left": "1.25rem"
          }
        },
        "typography": {
          "fontStyle": "italic"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-no-title",
      "title": "Page (no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}