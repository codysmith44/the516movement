{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1280px"
    },
    "color": {
      "palette": [
        {
          "slug": "primary",
          "name": "M516 Blue",
          "color": "#0f75bc"
        },
        {
          "slug": "navy",
          "name": "Navy",
          "color": "#0b3e63"
        },
        {
          "slug": "night",
          "name": "Night",
          "color": "#05121f"
        },
        {
          "slug": "accent",
          "name": "Red",
          "color": "#c3272f"
        },
        {
          "slug": "glow",
          "name": "Glow",
          "color": "#f4b860"
        },
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#14202b"
        },
        {
          "slug": "muted",
          "name": "Slate",
          "color": "#4a545a"
        },
        {
          "slug": "paper",
          "name": "Paper",
          "color": "#f6f2ea"
        },
        {
          "slug": "light",
          "name": "Light",
          "color": "#ece6da"
        },
        {
          "slug": "base",
          "name": "White",
          "color": "#ffffff"
        }
      ],
      "gradients": [
        {
          "slug": "night-glow",
          "name": "Night glow",
          "gradient": "radial-gradient(120% 80% at 80% 0%, rgba(244,184,96,.35) 0%, rgba(11,62,99,0) 45%), linear-gradient(180deg,#0b3e63 0%,#05121f 100%)"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "heading",
          "name": "Newsreader",
          "fontFamily": "Newsreader, Georgia, 'Times New Roman', serif",
          "fontFace": [
            {
              "fontFamily": "Newsreader",
              "fontWeight": "200 800",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/newsreader-latin-opsz-normal.woff2"
              ]
            },
            {
              "fontFamily": "Newsreader",
              "fontWeight": "200 800",
              "fontStyle": "italic",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/newsreader-latin-opsz-italic.woff2"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Source Sans 3",
          "fontFamily": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Source Sans 3",
              "fontWeight": "200 900",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/source-sans-3-latin-wght-normal.woff2"
              ]
            },
            {
              "fontFamily": "Source Sans 3",
              "fontWeight": "200 900",
              "fontStyle": "italic",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/source-sans-3-latin-wght-italic.woff2"
              ]
            }
          ]
        },
        {
          "slug": "accent",
          "name": "Newsreader Italic",
          "fontFamily": "Newsreader, Georgia, 'Times New Roman', serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem"
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.0625rem",
          "fluid": {
            "min": "1rem",
            "max": "1.125rem"
          }
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "1.5rem",
          "fluid": {
            "min": "1.25rem",
            "max": "1.5rem"
          }
        },
        {
          "slug": "x-large",
          "name": "XL",
          "size": "2.75rem",
          "fluid": {
            "min": "2rem",
            "max": "2.75rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "XXL",
          "size": "4.5rem",
          "fluid": {
            "min": "2.75rem",
            "max": "4.5rem"
          }
        },
        {
          "slug": "huge",
          "name": "Display",
          "size": "8.5rem",
          "fluid": {
            "min": "3.4rem",
            "max": "8.5rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw"
      ],
      "spacingSizes": [
        {
          "slug": "20",
          "name": "2XS",
          "size": "0.5rem"
        },
        {
          "slug": "30",
          "name": "XS",
          "size": "1rem"
        },
        {
          "slug": "40",
          "name": "S",
          "size": "1.5rem"
        },
        {
          "slug": "50",
          "name": "M",
          "size": "clamp(2rem,4vw,3rem)"
        },
        {
          "slug": "60",
          "name": "L",
          "size": "clamp(3rem,6vw,5rem)"
        },
        {
          "slug": "70",
          "name": "XL",
          "size": "clamp(4.5rem,9vw,8rem)"
        },
        {
          "slug": "80",
          "name": "2XL",
          "size": "clamp(6rem,12vw,11rem)"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.7"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--40)",
      "padding": {
        "left": "clamp(1.25rem,5vw,3rem)",
        "right": "clamp(1.25rem,5vw,3rem)"
      }
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "600",
          "lineHeight": "1.05",
          "letterSpacing": "-0.015em"
        },
        "color": {
          "text": "var(--wp--preset--color--navy)"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--navy)"
          }
        },
        ":focus": {
          "outline": {
            "width": "2px",
            "style": "solid",
            "color": "var(--wp--preset--color--accent)",
            "offset": "2px"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--navy)",
          "text": "#fff"
        },
        "border": {
          "radius": "999px"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontWeight": "600",
          "fontSize": "1.0625rem",
          "textTransform": "none",
          "letterSpacing": "0"
        },
        "spacing": {
          "padding": {
            "top": "1rem",
            "bottom": "1rem",
            "left": "1.75rem",
            "right": "1.75rem"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--night)"
          }
        },
        ":focus": {
          "outline": {
            "width": "3px",
            "style": "solid",
            "color": "var(--wp--preset--color--glow)",
            "offset": "3px"
          }
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)",
          "letterSpacing": "0.01em"
        }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontSize": "1.0625rem",
          "fontWeight": "500"
        }
      },
      "core/quote": {
        "border": {
          "left": {
            "color": "var(--wp--preset--color--accent)",
            "width": "3px"
          }
        },
        "spacing": {
          "padding": {
            "left": "1.5rem"
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--accent)",
          "fontStyle": "italic",
          "fontSize": "var(--wp--preset--font-size--large)",
          "lineHeight": "1.35"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-no-title",
      "title": "Page (no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}